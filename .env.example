# ─────────────────────────────────────────────────────────────────────────────
# LLM provider
#
# Quarry talks to LLMs through LiteLLM, so any provider it supports works.
# Pick ONE for LLM_PROVIDER and put that vendor's key in LLM_API_KEY.
#
#   Provider   LLM_PROVIDER value              Get an API key at
#   ────────   ─────────────────────────────   ─────────────────────────────────
#   Cohere     cohere/command-a-03-2025        https://dashboard.cohere.com/api-keys
#   OpenAI     openai/gpt-4o-mini              https://platform.openai.com/api-keys
#   Anthropic  anthropic/claude-sonnet-4-5     https://console.anthropic.com/settings/keys
#   Google     gemini/gemini-2.0-flash         https://aistudio.google.com/app/apikey
#   Groq       groq/llama-3.3-70b-versatile    https://console.groq.com/keys
#   Ollama     ollama_chat/qwen2.5:14b         no key needed — runs locally
#
# Fully local? Install Ollama (https://ollama.com), `ollama pull qwen2.5:14b`,
# set LLM_PROVIDER=ollama_chat/qwen2.5:14b and leave LLM_API_KEY empty.
#
# Providers can also be changed later in the app's Settings page.
#
# This file may be saved with or without a UTF-8 BOM, and may hold keys Quarry
# does not use itself (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...): both are
# tolerated. An empty value (e.g. CRAWL_TIMEOUT=) means "use the default".
# ─────────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=cohere/command-a-03-2025

# Key for the hosted provider above. Leave empty for Ollama. If you would rather
# use the vendor's own variable (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...), set
# that instead and leave this blank — LiteLLM will pick it up.
LLM_API_KEY=

# Optional "fast" tier for summarization-style calls (brief synthesis + document
# extraction), while LLM_PROVIDER handles planning and assessment. Leave empty
# to use LLM_PROVIDER for everything. A local Ollama model is a good fit here:
# it keeps the high-volume calls free. From a container on Docker Desktop, the
# host is reachable at host.docker.internal.
LLM_PROVIDER_FAST=
OLLAMA_API_BASE=http://host.docker.internal:11434

# Per-call timeout for LLM requests, in seconds (default 120). A hung provider
# otherwise holds a mission worker, and its job slot, indefinitely.
LLM_TIMEOUT_S=120

# ─── Search & crawl ──────────────────────────────────────────────────────────
SEARCH_MAX_RESULTS=5
CRAWL_TIMEOUT=30000
DB_PATH=data/research.db

# ─── Serving ─────────────────────────────────────────────────────────────────
# Interface the local dev server (`python app.py`) listens on. Defaults to
# 127.0.0.1 (this machine only). The Docker image runs gunicorn with its own
# bind address and publishes it via QUARRY_BIND below, so this does not
# affect Docker.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Host interface Docker publishes the app on. Default 127.0.0.1 = this machine
# only. Set a QUARRY_PASSWORD before widening this to 0.0.0.0.
QUARRY_BIND=127.0.0.1

# ─── Access control ──────────────────────────────────────────────────────────
# Optional login password. Empty = no login (keep the app localhost-only).
# Accepts plaintext or a Werkzeug hash if you'd rather not keep plaintext here:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
QUARRY_PASSWORD=
# Set true only when serving behind a TLS-terminating reverse proxy: trusts one
# proxy hop for client IPs (login rate limiting) and marks the session cookie
# Secure. Leave false for plain localhost HTTP.
QUARRY_BEHIND_PROXY=false
# Comma-separated extra hostnames accepted in the Host header, on top of
# localhost / 127.0.0.1 / [::1]. While no QUARRY_PASSWORD is set, any other
# Host is refused, which blocks DNS-rebinding attacks on a password-less
# install. With a password set, the list is enforced only if non-empty.
# If you browse to Quarry under another name (a Tailscale or LAN hostname),
# list it here, e.g.:
#   QUARRY_TRUSTED_HOSTS=quarry.lan,my-pc.tailnet.ts.net
QUARRY_TRUSTED_HOSTS=
# Optional: override the session signing key (>=32 hex chars). Leave empty and
# a key is generated once and persisted in data/secret_key, so login sessions
# survive restarts.
FLASK_SECRET_KEY=

# Deprecated: early versions assumed Cohere. Still honoured if LLM_API_KEY is
# empty, but prefer LLM_API_KEY above.
# COHERE_API_KEY=
